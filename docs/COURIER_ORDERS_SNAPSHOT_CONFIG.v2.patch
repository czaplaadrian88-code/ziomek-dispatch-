+def test_mutation_explicit_route_config_wins_over_module_globals(monkeypatch):
+    calls = []
+
+    class RoutePodjazdy:
+        @staticmethod
+        def build_stop_sequence(_bag, _plan, *, plan_aware, trust_canon):
+            calls.append((plan_aware, trust_canon))
+            return [{"order_id": "1", "kind": "pickup"}]
+
+    monkeypatch.setattr(courier_orders, "_route_podjazdy", RoutePodjazdy)
+    monkeypatch.setattr(config, "PLAN_AWARE_PODJAZDY", True)
+    monkeypatch.setattr(config, "BUILD_VIEW_TRUST_CANON_ORDER", True)
+    explicit_off = courier_orders.RouteConfig(
+        app_route_from_console=False,
+        route_order_unified=True,
+        plan_aware_podjazdy=False,
+        build_view_trust_canon_order=False,
