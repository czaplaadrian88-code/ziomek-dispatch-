+    sequence = [{"order_id": "1", "kind": "pickup"}]
+    mine = {"1": {"order_id": "1", "status": "assigned"}}
+    courier_orders._reorder_steps_to_canon(
+        sequence, mine, None, explicit_off
+    )
+    assert calls == [(False, False)]
