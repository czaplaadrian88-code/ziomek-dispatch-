+    plans_snapshot = json.loads(wired["plans"].read_text())
+    explicit = courier_orders.build_view_from_snapshots(
+        CID,
+        orders_snapshot,
+        plans_snapshot,
+        courier_orders.RouteConfig.from_module_config(),
+    )
+    assert json.dumps(wrapped, sort_keys=True) == json.dumps(
