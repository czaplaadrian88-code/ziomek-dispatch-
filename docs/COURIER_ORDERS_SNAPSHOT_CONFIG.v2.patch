+@dataclass(frozen=True)
+class RouteConfig:
+    """Route-order switches passed explicitly across the DTO build boundary."""
+
+    app_route_from_console: bool
+    route_order_unified: bool
+    plan_aware_podjazdy: bool
+    build_view_trust_canon_order: bool
+
+    ENV_BY_FIELD: ClassVar[dict[str, str]] = {
+        "app_route_from_console": "ENABLE_APP_ROUTE_FROM_CONSOLE",
+        "route_order_unified": "ENABLE_ROUTE_ORDER_UNIFIED",
+        "plan_aware_podjazdy": "ENABLE_PLAN_AWARE_PODJAZDY",
+        "build_view_trust_canon_order": "ENABLE_BUILD_VIEW_TRUST_CANON_ORDER",
+    }
+
+    @classmethod
+    def from_module_config(cls) -> "RouteConfig":
+        return cls(
+            app_route_from_console=config.APP_ROUTE_FROM_CONSOLE,
+            route_order_unified=config.ROUTE_ORDER_UNIFIED,
+            plan_aware_podjazdy=config.PLAN_AWARE_PODJAZDY,
+            build_view_trust_canon_order=config.BUILD_VIEW_TRUST_CANON_ORDER,
+        )
+
+    @classmethod
+    def from_environ(cls, environ: Mapping[str, str]) -> "RouteConfig":
+        """Apply the same exact ``value == "1"`` semantics as config.py."""
+        return cls(
+            **{
+                field: environ.get(env_name, "0") == "1"
+                for field, env_name in cls.ENV_BY_FIELD.items()
+            }
+        )
+
+    def as_dict(self) -> dict[str, bool]:
+        return {
+            field: getattr(self, field)
+            for field in self.ENV_BY_FIELD
+        }
+
